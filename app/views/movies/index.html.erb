<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  <thead>
    <tr>
	  <th scope="col"
	            class="<%= @sort_column == 'title' ? "sorted-#{@sort_direction}" : '' %>"
	            aria-sort="<%= @sort_column == 'title' ? (@sort_direction == 'asc' ? 'ascending' : 'descending') : 'none' %>">
	          <%= link_to "Title #{@sort_column == 'title' ? (@sort_direction == 'asc' ? '▲' : '▼') : ''}",
	              movies_path(
	                sort: "title",
	                direction: @sort_column == "title" && @sort_direction == "asc" ? "desc" : "asc"
	              ) %>
	        </th>

	        <th scope="col"
	            class="<%= @sort_column == 'rating' ? "sorted-#{@sort_direction}" : '' %>"
	            aria-sort="<%= @sort_column == 'rating' ? (@sort_direction == 'asc' ? 'ascending' : 'descending') : 'none' %>">
	          <%= link_to "Rating #{@sort_column == 'rating' ? (@sort_direction == 'asc' ? '▲' : '▼') : ''}",
	              movies_path(
	                sort: "rating",
	                direction: @sort_column == "rating" && @sort_direction == "asc" ? "desc" : "asc"
	              ) %>
	        </th>

	        <th scope="col"
	            class="<%= @sort_column == 'release_date' ? "sorted-#{@sort_direction}" : '' %>"
	            aria-sort="<%= @sort_column == 'release_date' ? (@sort_direction == 'asc' ? 'ascending' : 'descending') : 'none' %>">
	          <%= link_to "Release Date #{@sort_column == 'release_date' ? (@sort_direction == 'asc' ? '▲' : '▼') : ''}",
	              movies_path(
	                sort: "release_date",
	                direction: @sort_column == "release_date" && @sort_direction == "asc" ? "desc" : "asc"
	              ) %>
	        </th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date.strftime("%b %d, %Y") %></td>
      </tr>
    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td colspan="3">
		  Total Movies: <%= @movies.size %>
	  </td>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path %>
