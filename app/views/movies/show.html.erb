
<p style="color: green"><%= notice %></p>

<div class="movie-page">
  <h1>Movie Details</h1>
  <p class="page-subtitle">View and manage this movie.</p>

  <div class="movie-card">
    <%= render @movie %>
  </div>

  <div class="movie-actions">
    <%= link_to "Edit this movie", edit_movie_path(@movie), class: "action-link" %>
    <%= link_to "← Back to movies", movies_path, class: "action-link" %>
    <%= button_to "Delete movie", @movie, method: :delete, class: "delete-button",
        form: { data: { turbo_confirm: "Are you sure you want to delete this movie?" } } %>
  </div>
</div>
