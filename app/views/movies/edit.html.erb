
<% content_for :title, "Editing movie" %>

<div class="movie-page">
  <h1>Edit Movie</h1>
  <p class="page-subtitle">Update the movie information below.</p>

  <div class="movie-card">
    <%= render "form", movie: @movie %>
  </div>

  <div class="movie-actions">
    <%= link_to "View movie", @movie, class: "action-link" %>
    <%= link_to "← Back to movies", movies_path, class: "action-link" %>
  </div>
</div>
